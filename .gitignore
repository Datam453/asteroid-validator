# Keep the repository limited to source, tests and project documentation.
/*
!/.gitignore
!/README.md
!/v1/
!/V2/

/v1/*
!/v1/.gitignore
!/v1/README.md
!/v1/pyproject.toml
!/v1/run.ps1
!/v1/src/
!/v1/tests/
!/v1/docs/

/V2/*
!/V2/.gitignore
!/V2/README.md
!/V2/pyproject.toml
!/V2/run.ps1
!/V2/src/
!/V2/tests/
!/V2/docs/

**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/.env
**/.env.*
**/node_modules/
/V2/docs/build_pipeline_pdf.py
/V2/docs/v2-pipeline.tex
